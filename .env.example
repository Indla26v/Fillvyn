# Vercel Postgres / Neon database. Without it, submissions are kept in memory and lost on restart.
POSTGRES_URL=""

# Admin portal passkey (required to enable the admin portal; at least 12 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_PASSKEY=""

# Optional: separate secret for signing admin sessions (defaults to one derived from ADMIN_PASSKEY)
ADMIN_SESSION_SECRET=""

# Public site URL used for canonical links, sitemap and social previews
NEXT_PUBLIC_SITE_URL="https://fillvyn.vercel.app"

# Chrome Web Store Extension Link
NEXT_PUBLIC_CHROME_EXTENSION_URL="https://chromewebstore.google.com/detail/fillvyn-ai-forms-auto-fil/jcemhdibdeekkkjeoenokjlhcfjkhinf"
